PORT=4001
# Each service owns its own database
MONGO_URI=
# Must match the gateway
INTERNAL_SECRET=change-me-to-another-long-random-string
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-32+
# Short-lived access token + rotating refresh token (14 days)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
# Frontend origin used in email links
APP_URL=http://localhost:3000
# Optional Gmail SMTP for reset/verification emails (MOCK mode when empty)
GMAIL_USER=
GMAIL_APP_PASSWORD=
BCRYPT_ROUNDS=12
# true when served over HTTPS
COOKIE_SECURE=false
# Seed script (npm run seed) – the ONLY way an ADMIN account is created
SEED_ADMIN_EMAIL=admin@careerpilot.dev
SEED_ADMIN_PASSWORD=change-me-Admin1
SEED_DEMO_PASSWORD=change-me-Demo1
