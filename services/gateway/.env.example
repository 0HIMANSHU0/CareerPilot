# Public port of the API gateway
PORT=4000
# Internal service URLs (in Docker: http://auth-service:4001 etc.)
AUTH_SERVICE_URL=http://localhost:4001
AI_SERVICE_URL=http://localhost:4002
BOOKING_SERVICE_URL=http://localhost:4003
# Must match auth-service JWT_ACCESS_SECRET (gateway verifies tokens locally). Min 32 chars.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-32+
# Shared secret used to sign gateway -> service internal tokens. Min 32 chars.
INTERNAL_SECRET=change-me-to-another-long-random-string
# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
# Number of reverse proxies in front of the gateway (for correct client IP in rate limiting)
TRUST_PROXY=1
PROXY_TIMEOUT_MS=120000
DASHBOARD_TIMEOUT_MS=1500
