PORT=4002
MONGO_URI=
INTERNAL_SECRET=change-me-to-another-long-random-string
# Optional. Leave empty to run the AI assistant in MOCK mode (canned streamed replies).
EMERGENT_LLM_KEY=
# OpenAI-compatible chat completions endpoint
LLM_BASE_URL=https://integrations.emergentagent.com/llm
LLM_MODEL=claude-opus-5-5
LLM_TIMEOUT_MS=90000
LLM_MAX_RETRIES=2
# How many previous messages are sent as conversation context
CHAT_CONTEXT_MESSAGES=20
# Per-user limit for LLM calls (chat messages + resume generation)
AI_RATE_LIMIT_PER_MINUTE=20
