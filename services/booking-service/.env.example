PORT=4003
MONGO_URI=
INTERNAL_SECRET=change-me-to-another-long-random-string
# Allowed frontend origins for Stripe success/cancel redirects (prevents open redirects)
APP_ORIGINS=http://localhost:3000
# Unpaid bookings release their slot after this many minutes
PAYMENT_HOLD_MINUTES=30
# Each provider below runs in MOCK mode when its keys are empty.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Google Calendar: service account JSON (single line) + calendar id shared with that service account
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=
# Gmail SMTP (use an App Password)
GMAIL_USER=
GMAIL_APP_PASSWORD=
